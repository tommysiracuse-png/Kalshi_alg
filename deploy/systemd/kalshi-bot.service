[Unit]
Description=Kalshi market-maker fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Kalshi_alg
EnvironmentFile=%h/.config/kalshi-alg/bot.env
ExecStart=%h/Kalshi_alg/run_lip.sh
KillSignal=SIGINT
KillMode=mixed
# Account-wide shutdown cancels and re-queries resting bot orders before exit.
# Leave enough time for venue throttling/retries; systemd must not SIGKILL the
# manager in the middle of that safety-critical cleanup.
MemoryHigh=24G
MemoryMax=28G
TasksMax=256
LimitNOFILE=65536
TimeoutStopSec=300
Restart=on-failure
RestartSec=10
OOMPolicy=stop

[Install]
WantedBy=default.target
