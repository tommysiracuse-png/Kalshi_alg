[Unit]
Description=Kalshi operations Next.js UI
After=kalshi-ui-api.service
Wants=kalshi-ui-api.service

[Service]
Type=simple
WorkingDirectory=%h/Kalshi_alg/web
EnvironmentFile=%h/.config/kalshi-alg/ui.env
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
