# Copy to .env and fill in values before running locally

# Secret used to sign JWT access tokens. Use a long random string in production
# (in AWS this is injected from Secrets Manager — see terraform/secrets.tf).
JWT_SECRET=local-dev-insecure-secret-change-me

# Comma-separated list of allowed CORS origins for the consuming app ("*" for any)
CORS_ALLOW_ORIGINS=*

# AWS credentials (for SES and SNS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Email address SES sends 2FA codes from (must be verified in SES)
SES_FROM_EMAIL=no-reply@yourdomain.com

# Only needed when running against a real DB (not docker-compose)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
